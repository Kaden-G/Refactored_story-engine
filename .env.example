# MAMS Database Connection
# Note: MAMS_DB_USER is the PostgreSQL role; on a Homebrew install this
# is usually your local macOS username, not "postgres".
MAMS_DB_HOST=localhost
MAMS_DB_PORT=5432
MAMS_DB_NAME=mams
MAMS_DB_USER=postgres
MAMS_DB_PASSWORD=

# LangGraph orchestration layer. Without an API key, agents fall back
# to deterministic rule-based stubs (useful for tests).
ANTHROPIC_API_KEY=
# Override the Claude model id (default: claude-sonnet-4-20250514)
# STORY_ENGINE_MODEL=

# FastAPI CORS: extra allowed origin beyond localhost:3000
# FRONTEND_ORIGIN=https://your.app
